{
  "name": "runas-launcher-ui",
  "version": "0.9.0",
  "description": "Minimal Electron UI that wraps the Python run-as launcher.",
  "repository": {
    "type": "git",
    "url": "https://github.com/baohh2504-cmd/clone-app.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "checksum": "node scripts/generate-checksums.js release",
    "build:launcher": "cd ../launcher && pyinstaller --onefile --noconsole --noconfirm --clean --specpath build runas_launcher.py",
    "pack:win": "npm run build:launcher && electron-packager . \"Clone App\" --platform=win32 --arch=x64 --out dist --overwrite --icon=assets/icon.ico --extra-resource=../launcher",
    "dist:win": "npm run build:launcher && electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [
    "electron",
    "runas",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {},
  "devDependencies": {
    "electron": "^34.1.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.runclone.app",
    "productName": "Clone App",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!release/**",
      "!resources/extracted_app/**",
      "!**/*.log",
      "!**/*debug*.txt",
      "!**/*.tmp",
      "!ui-data/**",
      "!dist-debug/**",
      "!temp/**",
      "!tmp/**",
      "!.cache/**"
    ],
    "asarUnpack": [
      "**/preload.js",
      "**/renderer.js"
    ],
    "extraResources": [
      {
        "from": "../launcher",
        "to": "launcher"
      },
      {
        "from": "./launcher",
        "to": "launcher"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "CloneApp-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Clone App",
      "createDesktopShortcut": true
    }
  }
}
