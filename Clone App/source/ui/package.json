{
  "name": "runas-launcher-ui",
  "version": "0.3.0",
  "description": "Minimal Electron UI that wraps the Python run-as launcher.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "obfuscate": "node scripts/build-obfuscated.js",
    "compile:bytenode": "node scripts/compile-bytenode.js",
    "checksum": "node scripts/generate-checksums.js release",
    "checksum:obfuscated": "node scripts/generate-checksums.js build/release",
    "pack:win": "electron-packager . \"Clone App\" --platform=win32 --arch=x64 --out dist --overwrite --icon=assets/icon.ico --extra-resource=../launcher",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:obfuscated": "npm run obfuscate && npm run compile:bytenode && cd build && npx electron-builder --win nsis --x64"
  },
  "keywords": [
    "electron",
    "runas",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bytenode": "^1.5.7"
  },
  "devDependencies": {
    "electron": "^34.1.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "javascript-obfuscator": "^5.2.1"
  },
  "build": {
    "appId": "com.runclone.app",
    "productName": "Clone App",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "**/*",
      "!antiVM.js",
      "!dist/**",
      "!release/**",
      "!resources/extracted_app/**",
      "!**/*.log",
      "!**/*debug*.txt",
      "!**/*.tmp",
      "!ui-data/**",
      "!dist-debug/**",
      "!temp/**",
      "!tmp/**",
      "!.cache/**"
    ],
    "asarUnpack": [
      "**/*.jsc",
      "**/integrity.json",
      "**/preload.js",
      "**/renderer.js"
    ],
    "extraResources": [
      {
        "from": "../launcher",
        "to": "launcher"
      },
      {
        "from": "./launcher",
        "to": "launcher"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "CloneApp-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Clone App",
      "createDesktopShortcut": true
    }
  }
}