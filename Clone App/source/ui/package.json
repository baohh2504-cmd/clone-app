{
  "name": "runas-launcher-ui",
  "version": "0.2.3",
  "description": "Minimal Electron UI that wraps the Python run-as launcher.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-packager . \"Run Clone App\" --platform=win32 --arch=x64 --out dist --overwrite --icon=assets/icon.ico --extra-resource=../launcher",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "keywords": [
    "electron",
    "runas",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^34.1.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.runclone.app",
    "productName": "Run Clone App",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!release/**"
    ],
    "extraResources": [
      {
        "from": "../launcher",
        "to": "launcher"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "RunCloneApp-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Run Clone App",
      "createDesktopShortcut": true
    }
  }
}
